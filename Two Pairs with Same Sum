import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;
class Solution {
    public ArrayList<Integer> findPairs(int[] arr) {
        int n = arr.length;
        Map<Integer, int[]> firstPairForSum = new HashMap<>();
        int[] best = null;
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int sum = arr[i] + arr[j];
                if (!firstPairForSum.containsKey(sum)) {
                    // Store only the lexicographically smallest pair for this sum
                    firstPairForSum.put(sum, new int[]{i, j});
                } else {
                    int[] prev = firstPairForSum.get(sum);
                    int a = prev[0];
                    int b = prev[1];
                    // Ensure all four indices are distinct
                    if (a != i && a != j && b != i && b != j) {
                        int[] candidate = new int[]{a, b, i, j};
                        if (best == null || isLexSmaller(candidate, best)) {
                            best = candidate;
                        }
                    }
                }
            }
        }
        if (best == null) {
            return new ArrayList<>(Arrays.asList(-1, -1, -1, -1));
        }
        return new ArrayList<>(Arrays.asList(best[0], best[1], best[2], best[3]));
    }
    private boolean isLexSmaller(int[] cand, int[] best) {
        for (int k = 0; k < 4; k++) {
            if (cand[k] != best[k]) {
                return cand[k] < best[k];
            }
        }
        return false;
    }
}