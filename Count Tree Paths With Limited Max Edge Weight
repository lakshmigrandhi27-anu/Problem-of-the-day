import java.util.*;
class Solution {
    int[] parent, size;
    int find(int x) {
        if (parent[x] != x) {
            parent[x] = find(parent[x]);
        }
        return parent[x];
    }
    void union(int u, int v) {
        int pu = find(u);
        int pv = find(v);
        if (pu == pv) {
            return;
        }
        if (size[pu] < size[pv]) {
            int temp = pu;
            pu = pv;
            pv = temp;
        }
        parent[pv] = pu;
        size[pu] += size[pv];
    }
    public ArrayList<Integer> maximumWeight(
        int n, int[][] edges, int[] queries) {
        // IMPORTANT: n + 1 because vertices start from 1
        parent = new int[n + 1];
        size = new int[n + 1];
        for (int i = 1; i <= n; i++) {
            parent[i] = i;
            size[i] = 1;
        }
        Arrays.sort(edges, (a, b) ->
            Integer.compare(a[2], b[2]));
        Integer[] idx = new Integer[queries.length];
        for (int i = 0; i < queries.length; i++) {
            idx[i] = i;
        }
        Arrays.sort(idx, (a, b) ->
            Integer.compare(queries[a], queries[b]));
        ArrayList<Integer> ans =
            new ArrayList<>(
                Collections.nCopies(queries.length, 0));
        int j = 0;
        int count = 0;
        for (int id : idx) {
            int limit = queries[id];
            while (j < edges.length &&
                   edges[j][2] <= limit) {
                int u = edges[j][0];
                int v = edges[j][1];
                int pu = find(u);
                int pv = find(v);
                if (pu != pv) {
                    count += size[pu] * size[pv];
                    union(u, v);
                }
                j++;
            }
            ans.set(id, count);
        }
        return ans;
    }
}