import java.util.*;
class Solution {
    public ArrayList<String> generateUsernames(String[] arr) {
        HashSet<String> reserved = new HashSet<>();
        HashSet<String> assigned = new HashSet<>();
        HashMap<String, Integer> next = new HashMap<>();
        // Store all original usernames
        for (String s : arr) {
            reserved.add(s);
        }
        ArrayList<String> ans = new ArrayList<>();
        for (String s : arr) {
            if (!assigned.contains(s)) {
                ans.add(s);
                assigned.add(s);
            } else {
                int num = next.getOrDefault(s, 1);
                String candidate = s + num;
                while (reserved.contains(candidate) ||
                       assigned.contains(candidate)) {
                    num++;
                    candidate = s + num;
                }
                ans.add(candidate);
                assigned.add(candidate);
                next.put(s, num + 1);
            }
        }
        return ans;
    }
}