import java.util.ArrayList;
class Solution {
    public ArrayList<Integer> countVowels(String s, int[][] queries) {
        int n = s.length();
        int[] prefix = new int[n + 1];
        // Build prefix sum array of vowel counts
        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + (isVowel(s.charAt(i)) ? 1 : 0);
        }
        // Answer each range query in O(1) time
        ArrayList<Integer> result = new ArrayList<>(queries.length);
        for (int[] query : queries) {
            int l = query[0];
            int r = query[1];
            result.add(prefix[r + 1] - prefix[l]);
        }
        return result;
    }
    private boolean isVowel(char ch) {
        return ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u';
    }
}