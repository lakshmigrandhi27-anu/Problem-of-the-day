class Solution {
    static final long MOD = 1000000007;
    static long countBT(int h) {
        if (h == 0) return 1;
        if (h == 1) return 1;
        long a = 1; // dp[0]
        long b = 1; // dp[1]
        for (int i = 2; i <= h; i++) {
            long c = (b * b) % MOD;
            c = (c + (2 * b % MOD) * a % MOD) % MOD;
            a = b;
            b = c;
        }
        return b;
    }
}
