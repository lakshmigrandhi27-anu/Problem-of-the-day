class Solution {
    public int minTime(int n, int s1, int s2) {
        long low = 0;
        long high = Math.min((long)n * s1, (long)n * s2);
        long ans = high;
        while (low <= high) {
            long mid = low + (high - low) / 2;
            long total = mid / s1 + mid / s2;
            if (total >= n) {
                ans = mid;
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }
        return (int) ans;
    }
}
